# Copy this file to .env on the VPS. Do not commit .env.

# PostgreSQL on the same VPS
DATABASE_URL=postgresql://ecom:CHANGE_ME@127.0.0.1:5432/ecom

# Long random string. Sessions stop working if this changes.
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Folder where product photos, payment screenshots, and voice notes are stored
UPLOAD_DIR=/var/www/ecom/storage

# First admin, used only when the database is empty
ADMIN_EMAIL=admin@suitwear.store
ADMIN_PASSWORD=change-this-password

# Set to true after HTTPS is working
COOKIE_SECURE=false
